NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# TEMPORARY — only while no live Firebase project exists yet (see
# docs/HANDOFF.md "TEMPORARY email/password auth"). Leave unset/false once
# Firebase is configured.
NEXT_PUBLIC_TEMP_AUTH_ENABLED=false

# Deployment topology only (see apps/web/src/middleware.ts) — not a secret,
# and not meaningful in local dev. One of: admin | company | unset.
PANEL_MODE=
